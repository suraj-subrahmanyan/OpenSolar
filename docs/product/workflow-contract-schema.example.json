{
  "schema_version": "solar.workflow_contract.v1",
  "description": "Example workflow contracts for the unification plan. Design artifacts only; no runtime is wired to these yet. Field semantics: workflow-contract-unification-plan.md section 2.",
  "compile_time_checks": [
    "every stage.task_type is admitted by every capsule in stage.allowed_capsules (task_type_in)",
    "every proof_obligation references an artifact in stage.outputs or a declared gate input",
    "obligation kinds legal for stage.node_kind only (patch_diff => node_kind=code)",
    "every output path resolves inside artifact_roots.canonical or a declared alias root",
    "every stage role resolves to >=1 healthy, non-deprecated operator under provider_policy",
    "graph instantiation is byte-identical for identical inputs (golden-file test)"
  ],
  "workflows": [
    {
      "workflow_id": "research.deepdive.rsi_demo",
      "version": "1.0",
      "title": "RSI DeepDive Report",
      "trigger": {
        "explicit_markers": [
          "deepdive",
          "deep dive",
          "deepresearch",
          "deep research",
          "深度研究",
          "深研",
          "深度调研报告"
        ],
        "env_gates": [
          {
            "env": "SOLAR_DEMO_REPORT_MODE",
            "equals": "1"
          }
        ],
        "requirement_compiler_type": "RESEARCH",
        "generic_words_insufficient": ["research", "研究", "调研"],
        "on_match": "bypass should_epic_decompose_request and PM epic decomposition; instantiate this contract as the task graph with dag_variant=research.deepdive.rsi_demo"
      },
      "provider_policy": {
        "runtime": "codex",
        "allowed_providers": ["openai"],
        "route_proof_required": true,
        "route_records": "per_stage_execution_append_only"
      },
      "source_mode": {
        "network": false,
        "seed_pack": "demo-rsi/source-pack/"
      },
      "artifact_roots": {
        "canonical": "workspace/rsi-deep-research-report/",
        "aliases": ["sprints/<sid>/workdir/rsi-deep-research-report/"],
        "publish_rule": "export stage copies canonical set to evidence/report/rsi-deep-research-report/"
      },
      "validator_command": "python3 scripts/validate_rsi_demo_report.py --workspace <resolved_root>",
      "release_proof_level": "P3",
      "dashboard": {
        "pipeline_strip": true
      },
      "forbidden": {
        "capsules": ["cap.requirement-compiler-implementation"],
        "proof_obligations": [
          "patch_diff",
          "patch_within_scope",
          "resource_binding.workspace_root"
        ]
      },
      "stages": [
        {
          "id": "D1",
          "gate_family": "DD_SCOPE",
          "node_kind": "analysis",
          "logical_operator": "DeepDiveBriefCapture",
          "depends_on": [],
          "task_type": "audit_inventory",
          "allowed_capsules": [
            "cap.requirement-research-scout",
            "cap.requirement-compiler-audit"
          ],
          "allowed_operators": {
            "role": "builder",
            "providers": ["openai"]
          },
          "outputs": [
            {
              "path": "scope-contract.json",
              "type": "json"
            }
          ],
          "proof_obligations": [
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "scope-contract.json"
            }
          ],
          "evaluator_gate": {
            "kind": "none"
          },
          "dashboard_label": "D1 · Scope",
          "timeouts": {
            "result_timeout_sec": 900,
            "on_timeout_classification": "ORCHESTRATION_WEDGE_NOT_PRODUCT_PROOF"
          }
        },
        {
          "id": "D2",
          "gate_family": "DD_SOURCE",
          "node_kind": "artifact",
          "logical_operator": "DeepDiveSourceCollector",
          "depends_on": ["D1"],
          "task_type": "audit_inventory",
          "allowed_capsules": ["cap.requirement-research-scout"],
          "allowed_operators": {
            "role": "builder",
            "providers": ["openai"]
          },
          "outputs": [
            {
              "path": "sources.json",
              "type": "json",
              "demo_artifact": true
            }
          ],
          "proof_obligations": [
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "sources.json"
            },
            {
              "kind": "acceptance",
              "requirement": "min_sources",
              "value": 5
            },
            {
              "kind": "acceptance",
              "requirement": "all_pack_sources_represented"
            }
          ],
          "evaluator_gate": {
            "kind": "deterministic_command",
            "command": "research eval-artifacts --sources",
            "on_fail": "repair_once_then_fail"
          },
          "dashboard_label": "D2 · Sources",
          "timeouts": {
            "result_timeout_sec": 900
          }
        },
        {
          "id": "D3",
          "gate_family": "DD_EVIDENCE",
          "node_kind": "artifact",
          "logical_operator": "DeepDiveClaimCompiler",
          "depends_on": ["D2"],
          "task_type": "evidence",
          "allowed_capsules": [
            "cap.requirement-research-synthesizer",
            "cap.requirement-compiler-audit"
          ],
          "allowed_operators": {
            "role": "builder",
            "providers": ["openai"]
          },
          "outputs": [
            {
              "path": "claims.json",
              "type": "json",
              "demo_artifact": true
            }
          ],
          "proof_obligations": [
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "claims.json"
            },
            {
              "kind": "acceptance",
              "requirement": "min_claims",
              "value": 10
            },
            {
              "kind": "acceptance",
              "requirement": "all_claim_source_ids_in_sources"
            }
          ],
          "evaluator_gate": {
            "kind": "deterministic_command",
            "command": "research eval-artifacts",
            "inputs_produced_by_this_gate": ["research_eval.json"],
            "on_fail": "repair_once_then_fail",
            "on_capacity_unavailable": "wait",
            "on_human_review": "warn_and_continue",
            "verdict_kinds": ["content", "mechanical", "infrastructure"]
          },
          "dashboard_label": "D3 · Claims",
          "timeouts": {
            "result_timeout_sec": 1200
          }
        },
        {
          "id": "D4",
          "gate_family": "DD_EVIDENCE",
          "node_kind": "analysis",
          "logical_operator": "DeepDiveContradictionScanner",
          "depends_on": ["D3"],
          "task_type": "evidence",
          "allowed_capsules": ["cap.requirement-research-synthesizer"],
          "allowed_operators": {
            "role": "builder",
            "providers": ["openai"]
          },
          "outputs": [
            {
              "path": "contradiction-matrix.json",
              "type": "json"
            }
          ],
          "proof_obligations": [
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "contradiction-matrix.json"
            }
          ],
          "evaluator_gate": {
            "kind": "none"
          },
          "dashboard_label": "D4 · Contradictions",
          "timeouts": {
            "result_timeout_sec": 900
          }
        },
        {
          "id": "D5",
          "gate_family": "DD_SYNTHESIS",
          "node_kind": "artifact",
          "logical_operator": "DeepDiveChiefEditor",
          "depends_on": ["D3", "D4"],
          "task_type": "reporting",
          "allowed_capsules": [
            "cap.requirement-research-synthesizer",
            "cap.requirement-compiler-audit"
          ],
          "allowed_operators": {
            "role": "builder",
            "providers": ["openai"]
          },
          "outputs": [
            {
              "path": "report.md",
              "type": "markdown",
              "demo_artifact": true
            },
            {
              "path": "report.html",
              "type": "html",
              "demo_artifact": true
            }
          ],
          "proof_obligations": [
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "report.md"
            },
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "report.html"
            },
            {
              "kind": "acceptance",
              "requirement": "html_present",
              "value": "<html"
            },
            {
              "kind": "acceptance",
              "requirement": "no_stub_tokens",
              "token_list": "validate_rsi_demo_report.py PLACEHOLDER_TOKENS"
            }
          ],
          "evaluator_gate": {
            "kind": "llm_eval",
            "role": "evaluator",
            "on_capacity_unavailable": "wait",
            "on_human_review": "warn_and_continue",
            "verdict_kinds": ["content", "mechanical", "infrastructure"]
          },
          "dashboard_label": "D5 · Report",
          "timeouts": {
            "result_timeout_sec": 1800
          }
        },
        {
          "id": "D6",
          "gate_family": "DD_PUBLISH",
          "node_kind": "publish",
          "logical_operator": "DeepDiveArtifactPublisher",
          "depends_on": ["D5"],
          "task_type": "documentation",
          "allowed_capsules": ["cap.requirement-compiler-audit"],
          "allowed_operators": {
            "role": "builder",
            "providers": ["openai"]
          },
          "outputs": [
            {
              "path": "evaluation-checklist.md",
              "type": "markdown",
              "demo_artifact": true
            }
          ],
          "proof_obligations": [
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "evaluation-checklist.md"
            },
            {
              "kind": "gate",
              "requirement": "all_required_artifacts_present"
            },
            {
              "kind": "gate",
              "requirement": "route_proof_ok"
            },
            {
              "kind": "gate",
              "requirement": "validator_command_exit_0"
            }
          ],
          "evaluator_gate": {
            "kind": "deterministic_command",
            "command": "python3 scripts/validate_rsi_demo_report.py",
            "on_fail": "fail"
          },
          "dashboard_label": "D6 · Publish",
          "timeouts": {
            "result_timeout_sec": 600
          }
        }
      ],
      "required_artifacts": [
        "report.html",
        "report.md",
        "sources.json",
        "claims.json",
        "evaluation-checklist.md"
      ],
      "note": "Compressed D1-D6 form of the original D1-D9 (see rsi-deepdive-workflow-lock.md for both and the mapping). | on_human_review=warn_and_continue is DEMO-ONLY (unattended run); general research contracts use block_dependents with bounded human-wait per review disposition 8.1."
    },
    {
      "workflow_id": "research.resource_radar",
