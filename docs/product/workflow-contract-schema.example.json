    {
      "workflow_id": "code.cli_smoke",
      "version": "1.0",
      "title": "Code smoke / CLI artifact",
      "trigger": {
        "explicit_markers": [],
        "selection": "explicit workflow_id only (used by isolated live E2E harness and prompt-matrix validation, not by free intake)",
        "on_match": "instantiate this contract"
      },
      "provider_policy": {
        "runtime": "codex",
        "allowed_providers": ["openai"],
        "route_proof_required": true,
        "route_records": "per_stage_execution_append_only"
      },
      "artifact_roots": {
        "canonical": "sprints/<sid>/workdir/",
        "aliases": [],
        "publish_rule": "none (workdir is canonical for code tasks)"
      },
      "validator_command": "python3 -m pytest <sid-workdir>/tests -q",
      "release_proof_level": "P2",
      "stages": [
        {
          "id": "S1",
          "gate_family": "G_BUILD",
          "node_kind": "code",
          "logical_operator": "ImplementationWorker",
          "depends_on": [],
          "task_type": "implementation",
          "allowed_capsules": ["cap.requirement-compiler-implementation"],
          "allowed_operators": {
            "role": "builder",
            "providers": ["openai"]
          },
          "outputs": [
            {
              "path": "<tool>.py",
              "type": "python"
            },
            {
              "path": "README.md",
              "type": "markdown"
            }
          ],
          "proof_obligations": [
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "<tool>.py"
            },
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "patch_diff"
            },
            {
              "kind": "self_check",
              "requirement": "check.patch_within_scope"
            },
            {
              "kind": "postcondition",
              "requirement": "output_present",
              "field": "handoff_md"
            }
          ],
          "evaluator_gate": {
            "kind": "llm_eval",
            "role": "evaluator",
            "on_capacity_unavailable": "wait",
            "on_human_review": "block_dependents",
            "verdict_kinds": ["content", "mechanical", "infrastructure"],
            "repair": {
              "max_attempts": 1,
              "generation_fenced": true,
              "single_flight": true
            }
          },
          "dashboard_label": "S1 · Implement",
          "timeouts": {
            "result_timeout_sec": 1200
          }
        },
        {
          "id": "S2",
          "gate_family": "G_SMOKE",
